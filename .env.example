# Copy this file to a new file named .env (same folder) and fill in your keys.
# Never share .env or upload it to GitHub.

# ---- LLM ----
# groq | openrouter | huggingface | gemini | ollama | lmstudio | openai | openai_compatible
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Leave blank to use the provider's default URL (only needed for openai_compatible)
LLM_BASE_URL=

# ---- Research ----
# tavily | firecrawl | website   (website = free, no key, reads each company's own site only)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
